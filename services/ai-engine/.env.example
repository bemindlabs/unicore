PORT=4200

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# Provider configuration
# Only the three wired adapters ship today: openai, anthropic, ollama.
# Additional providers (deepseek, groq, gemini, moonshot/kimi, mistral, xai,
# openrouter, together, fireworks, cohere) are roadmap — see provider-factory.service.ts.
LLM_PRIMARY_PROVIDER=openai
LLM_FAILOVER_PROVIDERS=anthropic,ollama
LLM_FAILOVER_ENABLED=true
LLM_REQUEST_TIMEOUT_MS=30000

# Token tracking
TOKEN_TRACKING_ENABLED=true
