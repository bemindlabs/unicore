{
  "name": "unicore-dashboard",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "prisma": "prisma",
    "test:e2e": "playwright test",
    "test:e2e:dashboard": "playwright test --project=dashboard",
    "test:e2e:platform": "playwright test --project=platform",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:ui": "playwright test --ui"
  },
  "pnpm": {
    "overrides": {
      "react": "^18.3.0",
      "react-dom": "^18.3.0",
      "glob": ">=10.5.0",
      "multer": ">=2.5.0 <3",
      "file-type": ">=21.3.2",
      "webpack": ">=5.104.1",
      "@tootallnate/once": ">=3.0.1",
      "flatted": ">=3.4.2",
      "effect": ">=3.20.0",
      "@prisma/config>effect": ">=3.20.0",
      "lodash": ">=4.18.0 <5",
      "tmp": ">=0.2.4",
      "handlebars": ">=4.7.10",
      "proxy-addr": ">=2.0.8",
      "protobufjs": ">=7.5.5",
      "simple-git": ">=4.0.1",
      "axios": ">=1.20.0 <2",
      "undici": ">=6.29.1 <7",
      "@grpc/grpc-js": ">=1.13.6 <2",
      "engine.io": ">=6.6.10 <7",
      "browserslist": ">=4.28.7 <5",
      "picomatch@^4": ">=4.0.4 <5",
      "defu": ">=6.1.5 <7",
      "form-data": ">=4.0.6 <5",
      "ws": ">=8.21.0 <9",
      "socket.io-parser": ">=4.2.7 <5",
      "source-map-js": ">=1.2.2 <2",
      "body-parser": ">=1.20.9 <2",
      "path-to-regexp@^0.1": "0.1.13",
      "path-to-regexp@8": "8.4.0",
      "js-yaml@^4": ">=4.3.2 <5",
      "nanoid@^5": ">=5.1.16 <6",
      "zod@^4": ">=4.6.6 <5"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "prisma": "^6.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "version": "0.1.2"
}
